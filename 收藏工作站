rmOverlay">  <div class="modal sm">    <div class="modal-head"><h2 id="confirmTitle">確認操作</h2></div>    <div class="modal-body"><div class="confirm-msg" id="confirmMsg"></div></div>    <div class="modal-foot">      <button class="btn ghost" onclick="closeConfirm()">取消</button>      <button class="btn danger" id="confirmOk">刪除</button>    </div>  </div></div>​<div class="toast" id="toast"></div>​<script>/* ============ 常量 ============ */const STORAGE_KEY = 'anti-hoarding-site-v2';const LEGACY_KEY = 'anti-hoarding-site-v1';​const DEFAULT_CATS = [  { key: 'create', name: '內容創作', color: '#12a150' },  { key: 'shop', name: '購物參考', color: '#f5a623' },  { key: 'aesthetic', name: '審美提升', color: '#d64541' },  { key: 'food', name: '美食地圖', color: '#e07b3a' },  { key: 'health', name: '健康生活', color: '#2f9e8f' },  { key: 'dev', name: '軟件開發', color: '#5b6bd6' },];// 「自我瞭解」用：喜好/觸動分類（可增刪）const DEFAULT_CATS2 = [  { key: 'value', name: '觀念共鳴', color: '#d64541' },  { key: 'style', name: '風格審美', color: '#0984e3' },  { key: 'life', name: '生活方式', color: '#12a150' },  { key: 'goal', name: '方向目標', color: '#f5a623' },  { key: 'heal', name: '情緒療愈', color: '#9b59b6' },];// 「地點標記」用：地點分類（可增刪）const DEFAULT_CATS3 = [  { key: 'food', name: '餐飲美食', color: '#e07b3a' },  { key: 'cafe', name: '咖啡甜品', color: '#a0616a' },  { key: 'view', name: '景點打卡', color: '#0984e3' },  { key: 'shop', name: '逛街購物', color: '#5b6bd6' },  { key: 'free', name: '隨性清單', color: '#636e72' },];const CAT_ALL = { key: 'all', name: '全部', color: '#6b6b6b', virtual: true };// 地點地區（固定三類，英文標籤）const REGION_META = {  foreign:  { en: 'Foreign',  zh: '外地', color: '#0984e3', badge: 'rb-foreign' },  mainland: { en: 'Mainland', zh: '內地', color: '#d64541', badge: 'rb-mainland' },  local:    { en: 'Local',    zh: '本地', color: '#12a150', badge: 'rb-local' },};const CAT_NONE = { key: 'none', name: '未分類', color: '#b2b2ae', virtual: true };const PALETTE = ['#12a150','#f5a623','#d64541','#e07b3a','#2f9e8f','#5b6bd6','#9b59b6','#e84393','#00b894','#0