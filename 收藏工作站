ngth + s.collections.length + p.collections.length;    askConfirm('導入備份', `將用備份（${n} 條記錄，導出於 ${new Date(d.exportedAt).toLocaleString('zh-CN')}）覆蓋當前全部數據，確定嗎？`, '覆蓋導入', () => {      try {        localStorage.setItem(STORAGE_KEY, JSON.stringify(c));        localStorage.setItem('anti-self-v1', JSON.stringify(s));        localStorage.setItem('anti-place-v1', JSON.stringify(p));        localStorage.setItem('anti-home-v1', JSON.stringify(Object.assign({}, DEFAULT_HOME, h || {})));        if (d.data.theme && normHex(d.data.theme)) localStorage.setItem(THEME_KEY, normHex(d.data.theme));        if (d.data.themePerSpace && typeof d.data.themePerSpace === 'object') {          const merged = { ...DEFAULT_THEME_PER_SPACE };          for (const k of Object.keys(DEFAULT_THEME_PER_SPACE)) {            if (d.data.themePerSpace[k] && normHex(d.data.themePerSpace[k])) merged[k] = normHex(d.data.themePerSpace[k]);          }          localStorage.setItem(THEME_PER_SPACE_KEY, JSON.stringify(merged));        }        toast('導入成功，正在刷新…');        setTimeout(() => location.reload(), 600);      } catch (e) {        toast('導入失敗：' + e.message);      }    });  };  reader.onerror = () => toast('讀取文件失敗，請重試');  reader.readAsText(file, 'utf-8');}​/* ============ 添加收藏彈窗 ============ */let editorSteps = [];const picked = new Set();​function openModal() {  const self = activeSpace === 'self';  const place = activeSpace === 'place';  $('#fTitle').value = ''; $('#fLink').value = ''; $('#fIdea').value = '';  editorSteps = [''];  picked.clear();  clearPickedImg();  // 空間差異化表單  if (place) {    $('#modalTitle').textContent = '📍 標記地點';    $('#fTitleLabel').textContent = '地點名稱';    $('#fTitle').placeholder = '例如：巷口那家老字號糖水鋪';    $('#fLink').placeholder = '地圖鏈接（可選）';    $('#fPlatformLabel').textContent = '來源';    $('#fPlatform').value = '小紅書';    $('#fIdeaLabel').textContent = '備註 · 想去幹嘛';    $('#fIdea').placeholder = '想吃什麼、想看什麼、打卡重點…';    $('#fIdeaHint').textContent = '例如：想吃鴛鴦刨冰 / 紅磚牆落日機位 / 週末下午去人少。';    $('#fLinkHint').style.display = '';    $('#fRegionField').style.display = '';    $('#fImgField').style.display = '';    $('#fStepsField').style.display = 'none';    $('#fTagLabel').textContent = '歸屬標籤（它屬於哪類去處，可多選）';    $('#fTagHint').textContent = '不選則歸入「未分類」；分類可在左側邊欄隨時新增 / 刪除。';    pickRegion('local');   // 默認本地  } else if (self) {    $('#modalTitle').textContent = '🌱 添加觸動記錄';    $('#fTitleLabel').textContent = '它是什麼（一件事 / 一句話 / 一個畫面）';    $('#fTitle').placeholder = '例如：一間安靜的書房，是我理想中家的樣子';    $('#fLink').placeholder = '粘貼鏈接 url';    $('#fIdeaLabel').textContent = '觸動';    $('#fIdea').placeholder = cur().site.selfIdeaHint || '收藏這個，是哪裡吸引到你了呢？';    $('#fIdeaHint').textContent = '寫下來，慢慢看見自己喜歡什麼、重視什麼。';    $('#fLinkHint').style.display = 'none';    $('#fRegionField').style.display = 'none';    $('#fImgField').style.display = 'none';    $('#fStepsField').style.display = 'none';    $('#fTagLabel').textContent = '歸屬標籤（它屬於哪種觸動，可多選）';  } else {    $('#modalTitle').textContent = '添加收藏';    $('#fTitleLabel').textContent = '標題（如無鏈接則自動生成，可修改）';    $('#fTitle').placeholder = '這條收藏講的是什麼';    $('#fLink').placeholder = '粘貼鏈接 url';    $('#fIdeaLabel').textContent = '想法';    $('#fIdea').placeholder = '一句話：當初為什麼收藏它？打算拿它做什麼？';    $('#fIdeaHint').textContent = '寫清楚動機，AI 才能幫你更好地拆解成行動。';    $('#fLinkHint').style.display = 'none';    $('#fRegionField').style.display = 'none';    $('#fImgField').style.display = 'none';    $('#fStepsField').style.display = '';    $('#fTagLabel').textContent = '歸屬標籤（為什麼做它，可多選）';  }  renderStepsEditor(); renderTagPick();  $('#overlay').classList.add('show');}/* 彈窗地區選擇 */let pickedRegion = 'local';function pickRegion(r) {  if (!REGION_META[r]) return;  pickedRegion = r;  document.querySelectorAll('.rg').forEach(b => b.classList.toggle('on', b.dataset.rg === r));}function closeModal() { $('#overlay').classList.remove('show'); clearPickedImg(); }function addStep() { editorSteps.push(''); renderStepsEditor(); }function renderStepsEditor() {  $('#stepsEditor').innerHTML = editorSteps.map((s, i) => `    <div class="se-row">      <input value="${esc(s)}" placeholder="步驟 ${i + 1}，例如：找到店鋪 → 加到購物車" oninput="editorSteps[${i}]=this.value">      <button class="del" onclick="editorSteps.splice(${i},1);renderStepsEditor()">✕</button>    </div>`).join('');}function renderTagPick() {  [...picked].forEach(k => { if (!cur().cats.find(c => c.key === k)) picked.delete(k); });  $('#tagPick').innerHTML = cur().cats.map(c =>    `<span class="tg" data-k="${c.key}" onclick="toggleTagPick('${c.key}')"><span style="color:${c.color}">●</span> ${esc(c.name)}</span>`).join('');}function toggleTagPick(k) {  if (picked.has(k)) picked.delete(k); else picked.add(k);  document.querySelectorAll('#tagPick .tg').forEach(t => t.classList.toggle('on', picked.has(t.dataset.k)));}function saveCollection() {  const title = $('#fTitle').value.trim();  const link = $('#fLink').value.trim();  const idea = $('#fIdea').value.trim();  const self = activeSpace === 'self';  const place = activeSpace === 'place';  if (place) {    // 地點標記：地點名必填，備註/圖片可選    if (!title) { toast('請填寫地點名稱'); return; }    cur().collections.unshift({      id: 'p' + Date.now(), title, link, platform: $('#fPlatform').value,      img: pickedImg || '',      region: REGION_META[pickedRegion] ? pickedRegion : 'local',      note: idea,      tags: [...picked], visited: false, createdAt: new Date().toISOString(), visitedAt: null,    });    persist(); renderAll(); closeModal(); clearPickedImg();    const rg = REGION_META[pickedRegion];    toast(`地點已標記 📍 ${rg.en}（${rg.zh}）`);    return;  }  if (self) {    // 自我瞭解：無步驟無狀態，標題或觸動至少填一個    if (!title && !idea) { toast('請寫下它是什麼，或哪裡觸動了你'); return; }    cur().collections.unshift({      id: 's' + Date.now(), title: title || idea.slice(0, 18),      link, platform: $('#fPlatform').value,      idea: idea || (cur().site.selfIdeaHint || '收藏這個，是哪裡吸引到你了呢？'),      tags: [...picked], createdAt: new Date().toISOString(),    });    persist(); renderAll(); closeModal();    toast(picked.size ? '心動記錄已保存 🌱' : '心動記錄已保存（未分類）🌱');    return;  }  const steps = editorSteps.map(s => s.trim()).filter(Boolean).map(t => ({ text: t, done: false }));  if (!title && !link) { toast('請至少填寫標題或鏈接'); return; }  const t = title || '來自鏈接的收藏';  state.collections.unshift({    id: 'c' + Date.now(), title: t, link, platform: $('#fPlatform').value,    idea: idea || '（沒有留下想法）', steps,    tags: [...picked], status: 'todo', createdAt: new Date().toISOString(), doneAt: null,  });  persist(); renderAll(); closeModal();  toast(picked.size ? '收藏已添加，快去拆解成行動吧 ✨' : '收藏已添加（未分類）✨');}​/* ============ 分類管理：新增 / 刪除 ============ */let newCatColor = PALETTE[0];​function openCatModal() {  $('#catName').value = '';  newCatColor = PALETTE[Math.floor(Math.random() * PALETTE.length)];  renderSwatches(); syncCatHex();  $('#catOverlay').classList.add('show');  setTimeout(() => $('#catName').focus(), 50);}function closeCatModal() { $('#catOverlay').classList.remove('show'); }function renderSwatches() {  $('#swatches').innerHTML = PALETTE.map(c =>    `<div class="swatch ${c === newCatColor ? 'on' : ''}" style="background:${c}" onclick="pickCatColor('${c}')" title="${c}"></div>`).join('');}function pickCatColor(c) {  newCatColor = c;  renderSwatches(); syncCatHex();}function syncCatHex() {  $('#catHex').value = newCatColor;  $('#catHexPreview').style.background = newCatColor;  $('#catHex').classList.add('hex-ok');}function saveCat() {  const name = $('#catName').value.trim();  if (!name) { toast('請輸入分類名稱'); return; }  if (cur().cats.some(c => c.name === name)) { toast('已存在同名分類'); return; }  cur().cats.push({ key: 'uc' + Date.now(), name, color: newCatColor });  persist(); closeCatModal(); renderAll();  toast(`分類「${name}」已添加 ✨`);}/* 分類 hex 輸入：合法即選中並更新色板 */$('#catHex').addEventListener('input', e => {  const hex = normHex(e.target.value);  if (hex) {    newCatColor = hex;    e.target.classList.add('hex-ok');    $('#catHexPreview').style.background = hex;    renderSwatches();  } else {    e.target.classList.remove('hex-ok');  }});function askDeleteCat(k) {  const cat = catOf(k);  const used = cur().collections.filter(c => (c.tags || []).includes(k));  const noun = activeSpace === 'self' ? '記錄' : '收藏';  const msg = used.length    ? `「${cat.name}」下還有 ${used.length} 條${noun}，刪除後這些${noun}將變為「未分類」。確定刪除嗎？`    : `確定刪除分類「${cat.name}」嗎？`;  askConfirm('刪除分類', msg, '刪除', () => deleteCat(k));}function deleteCat(k) {  const cat = catOf(k);  cur().cats = cur().cats.filter(c => c.key !== k);  cur().collections.forEach(c => { c.tags = (c.tags || []).filter(t => t !== k); });  if (ui.activeCat === k) ui.activeCat = 'all';  persist(); renderAll();  toast(`分類「${cat.name}」已刪除`);}function renameCatStart(k, iconEl) {  const item = iconEl.closest('.cat-item');  const nameEl = item.querySelector('.cname');  const cat = cur().cats.find(c => c.key === k);  if (!cat || !nameEl) return;  const input = document.createElement('input');  input.className = 'cat-rename';  input.value = cat.name;  input.maxLength = 12;  input.setAttribute('spellcheck', 'false');  nameEl.textContent = '';  nameEl.appendChild(input);  input.focus(); input.select();  input.addEventListener('click', e => e.stopPropagation());  input.addEventListener('dblclick', e => e.stopPropagation());  const finish = () => {    const v = input.value.trim();    if (v && v !== cat.name) {      if (cur().cats.some(c => c.name === v && c.key !== k)) { toast('已存在同名分類'); }      else { cat.name = v; persist(); toast('分類已重命名 ✎'); }    }    renderAll();  };  input.addEventListener('blur', finish);  input.addEventListener('keydown', e => {    if (e.key === 'Enter') { e.preventDefault(); input.blur(); }    if (e.key === 'Escape') { input.value = cat.name; input.blur(); }  });}​/* ============ 通用確認彈窗 ============ */let confirmCb = null;function askConfirm(title, msg, okText, cb) {  $('#confirmTitle').textContent = title;  $('#confirmMsg').textContent = msg;  $('#confirmOk').textContent = okText;  confirmCb = cb;  $('#confirmOverlay').classList.add('show');}function closeConfirm() { $('#confirmOverlay').classList.remove('show'); confirmCb = null; }$('#confirmOk').addEventListener('click', () => {  $('#confirmOverlay').classList.remove('show');  const cb = confirmCb; confirmCb = null; if (cb) cb();});​/* ============ 事件綁定 ============ */$('#searchInput').addEventListener('input', e => { ui.search = e.target.value.trim(); renderBoard(); });$('#todayAdd').addEventListener('click', addToday);$('#todayInput').addEventListener('keydown', e => { if (e.key === 'Enter') addToday(); });$('#calPrev').addEventListener('click', () => calShift(-1));$('#calNext').addEventListener('click', () => calShift(1));$('#overlay').addEventListener('click', e => { if (e.target.id === 'overlay') closeModal(); });$('#catOverlay').addEventListener('click', e => { if (e.target.id === 'catOverlay') closeCatModal(); });$('#trashOverlay').addEventListener('click', e => { if (e.target.id === 'trashOverlay') closeTrash(); });$('#confirmOverlay').addEventListener('click', e => { if (e.target.id === 'confirmOverlay') closeConfirm(); });$('#catName').addEventListener('keydown', e => { if (e.key === 'Enter') saveCat(); });​/* ============ 啓動 ============ */load();loadHome();applyThemeColor(getThemeForSpace(activeSpace));bindEditables();applySpaceUI();     // 初始在首頁入口（activeSpace = 'home'）updateFabs();</script></body></html>​

