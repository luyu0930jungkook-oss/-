ckground: #2b2b2b; color: #fff; padding: 11px 20px; border-radius: 10px;    font-size: 13px; box-shadow: 0 8px 24px rgba(0,0,0,.2); opacity: 0;    transition: opacity .25s, transform .25s; z-index: 100; pointer-events: none;  }  .toast.show { opacity: 1; transform: translateX(-50%) translateY(-4px); }​  .add-fab {    position: fixed; right: 30px; bottom: 30px;    background: var(--brand); color: #fff; border: none; border-radius: 50px;    padding: 13px 22px; font-size: 14px; font-weight: 700; cursor: pointer;    box-shadow: 0 8px 24px var(--brand-glow); display: flex; align-items: center; gap: 7px;    transition: transform .12s; z-index: 40;  }  .add-fab:hover { transform: translateY(-2px); background: var(--brand-dark); }​  /* ===== 卡片三點菜單 & Flag ===== */  .card { position: relative; }  .card.flagged { border-left: 3px solid var(--danger); }  .more-btn {    position: absolute; top: 10px; right: 10px;    width: 24px; height: 24px; border-radius: 7px;    display: grid; place-items: center; cursor: pointer;    color: var(--ink-faint); font-size: 15px; font-weight: 700; line-height: 1;    opacity: 0; transition: opacity .12s; z-index: 5;    letter-spacing: 1px;  }  .card:hover .more-btn { opacity: 1; }  .more-btn:hover { background: #f0f0ee; color: var(--ink); }  .card-menu {    position: absolute; top: 36px; right: 10px;    background: #fff; border: 1px solid var(--line-strong);    border-radius: 10px; box-shadow: 0 10px 32px rgba(0,0,0,.14);    min-width: 148px; padding: 5px; z-index: 30; display: none;  }  .card-menu.show { display: block; }  .card-menu .cm-item {    padding: 8px 12px; font-size: 13px; color: var(--ink);    border-radius: 7px; cursor: pointer; display: flex; align-items: center; gap: 7px;  }  .card-menu .cm-item:hover { background: #f5f5f3; }  .card-menu .cm-item.danger { color: var(--danger); }  .card-menu .cm-item.danger:hover { background: #fbeeec; }  .flag-badge { color: var(--danger); font-size: 12px; }​  /* 完成軌跡條目刪除 */  .track-day .items .it {