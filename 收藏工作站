anger-ghost:hover { background: #fbeeec; }  .btn.danger-ghost.danger { background: var(--danger); color: #fff; border-color: var(--danger); }​  /* ===== 右下角主題色按鈕 ===== */  .theme-fab {    position: fixed; right: 30px; bottom: 96px;    width: 46px; height: 46px; border-radius: 50%;    background: var(--panel); border: 1px solid var(--line-strong);    box-shadow: var(--shadow); cursor: pointer; z-index: 40;    display: grid; place-items: center; font-size: 19px;    transition: transform .12s;  }  .theme-fab:hover { transform: translateY(-2px); border-color: var(--brand); }  .theme-fab .dot-preview {    position: absolute; top: -2px; right: -2px;    width: 13px; height: 13px; border-radius: 50%;    background: var(--brand); border: 2px solid #fff;    box-shadow: 0 1px 4px rgba(0,0,0,.2);  }​  /* ===== Hex 輸入行 ===== */  .hex-row { display: flex; gap: 8px; align-items: center; }  .hex-row input {    flex: 1; border: 1px solid var(--line-strong); border-radius: 9px;    padding: 8px 12px; font-size: 13px; font-family: var(--mono);    outline: none; color: var(--ink);  }  .hex-row input:focus { border-color: var(--brand); box-shadow: 0 0 0 3px var(--brand-soft); }  .hex-row input.hex-ok { border-color: var(--brand); }  .hex-preview {    width: 38px; height: 34px; border-radius: 9px; border: 1px solid var(--line-strong);    background: #ccc; flex: 0 0 auto; transition: background .12s;  }​  /* ===== Google 風格主題色網格 ===== */  .g-grid {    display: grid; grid-template-columns: repeat(6, 1fr);    gap: 6px; padding: 2px;  }  .g-dot {    aspect-ratio: 1; border-radius: 50%; cursor: pointer; border: none;    position: relative; transition: transform .1s, box-shadow .1s;    box-shadow: inset 0 0 0 1px rgba(0,0,0,.06);  }  .g-dot:hover { transform: scale(1.14); box-shadow: 0 2px 8px rgba(0,0,0,.18); }  .g-dot.on {    box-shadow: 0 0 0 2px #fff, 0 0 0 4px var(--ink);  }  .g-dot.on::after {    content: "✓"; position: absolute; inset: 0; display: grid; place-items: center;    font-size: 11px; font-weight: 800; color: #fff;    text-shadow: 0 1px 2px rgba(0,0,0,.35);  }  .g-row-label {    grid-column: 1 / -1; font-size: 10px; color: var(--ink-faint);    padding: 4px 0 0; margin-top: -2px; letter-spacing: .04em;  }​  @media (max-width: 900px) {    .app { grid-template-columns: 1fr; }    .sidebar { display: none; }    .stats { grid-template-columns: 1fr; }    .cards, .cards.cols-3 { grid-template-columns: 1fr; }    .home-entry { padding: 40px 20px; }    .mobile-nav {      display: flex; gap: 6px; padding: 10px 14px;      background: var(--panel); border-bottom: 1px solid var(--line-strong);      position: sticky; top: 0; z-index: 30;    }    .mobile-nav .mn-item {      flex: 1; text-align: center; font-size: 12.5px; font-weight: 600;      color: var(--ink-soft); background: #f3f3f1; border-radius: 9px;      padding: 8px 4px; cursor: pointer;    }    .mobile-nav .mn-item.active { background: var(--brand-soft); color: var(--brand-dark); }  }​  /* ===== 首頁入口版面 ===== */  .home-entry {    display: none; flex-direction: column; align-items: center; justify-content: center;    min-height: 100vh; padding: 60px 30px; background: var(--bg);  }  .home-entry.show { display: flex; }  .home-brand { text-align: center; margin-bottom: 44px; }  .home-brand .hb-logo {    width: 54px; height: 54px; border-radius: 16px; margin: 0 auto 14px;    background: linear-gradient(135deg, var(--brand), var(--brand-grad2));    display: grid; place-items: center; color: #fff; font-size: 26px;    box-shadow: 0 6px 18px var(--brand-glow);  }  .home-brand .hb-name { font-size: 26px; font-weight: 800; letter-spacing: .5px; }  .home-brand .hb-sub { font-size: 13px; color: var(--ink-soft); margin-top: 6px; }  .home-cards { display: flex; gap: 22px; flex-wrap: wrap; justify-content: center; max-width: 760px; }  .home-card {    width: 320px; background: var(--panel); border: 1px solid var(--line-strong);    border-radius: 18px; padding: 30px 28px; cursor: pointer;    box-shadow: var(--shadow); transition: transform .16s, box-shadow .16s, border-color .16s;    display: flex; flex-direction: column; gap: 12px; position: relative;  }  .home-card:hover {    transform: translateY(-5px); border-color: var(--brand-semi);    box-shadow: 0 6px 14px rgba(0,0,0,.05), 0 20px 44px rgba(0,0,0,.09);  }  .home-card .hc-ico {    width: 46px; height: 46px; border-radius: 13px; display: grid; place-items: center;    font-size: 22px; background: var(--brand-soft); color: var(--brand-dark);  }  .home-card .hc-ico.alt { background: #eef2fd; color: #3b5bdb; }  .home-card .hc-name { font-size: 19px; font-weight: 800; display: flex; align-items: center; gap: 8px; }  .home-card .hc-desc { font-size: 13px; color: var(--ink-soft); line-height: 1.65; min-height: 44px; }  .home-card .hc-meta { font-size: 11px; color: var(--ink-faint); display: flex; gap: 12px; }  .home-card .hc-go {    position: absolute; top: 26px; right: 24px; width: 28px; height: 28px;    border-radius: 50%; display: grid; place-items: center;    background: var(--brand-soft); color: var(--brand-dark); font-size: 14px; font-weight: 700;    transition: transform .16s;  }  .home-card:hover .hc-go { transform: translateX(3px); }  .home-card .hc-stats { display: flex; gap: 14px; margin-top: 4px; }  .home-card .hc-stat { font-size: 11px; color: var(--ink-faint); }  .home-card .hc-stat b { color: var(--brand-dark); font-size: 14px; font-family: var(--mono); }  .home-foot { margin-top: 40px; font-size: 11px; color: var(--ink-faint); text-align: center; }​  /* ===== 側欄頂部三項導航 ===== */  .top-nav {    display: flex; flex-direction: column; gap: 3px;    padding: 10px 8px 14px; margin: -6px -8px 6px;    border-bottom: 1px solid var(--line); margin-bottom: 14px;  }  .top-nav-item {    display: flex; align-items: center; gap: 9px;    padding: 8px 11px; border-radius: 9px; cursor: pointer;    font-size: 13.5px; font-weight: 600; color: var(--ink-soft);    transition: background .12s, color .12s;  }  .top-nav-item:hover { background: #f2f2f0; }  .top-nav-item.active { background: var(--brand-soft); color: var(--brand-dark); }  .top-nav-item .tn-ico { font-size: 14px; width: 18px; text-align: center; }  .top-nav-item .tn-badge { font-size: 10px; background: #f1f1ef; color: var(--ink-faint); border-radius: 20px; padding: 1px 7px; margin-left: auto; }​  /* ===== 側欄底部：數據備份 ===== */  .side-backup {    margin-top: auto; padding-top: 6px;    border-top: 1px dashed var(--line-strong);  }  .backup-row { display: flex; gap: 8px; }  .backup-btn {    flex: 1; border: 1px solid var(--line-strong); background: var(--panel);    border-radius: 8px; padding: 8px 6px; font-size: 12px; font-weight: 600;    color: var(--ink-soft); cursor: pointer; font-family: inherit;    transition: border-color .12s, color .12s, background .12s;  }  .backup-btn:hover { border-color: var(--brand); color: var(--brand-dark); background: var(--brand-soft); }  .backup-note { font-size: 10.5px; color: var(--ink-faint); margin-top: 7px; line-height: 1.5; padding: 0 2px; }​  /* ===== 移動端 / 窄屏頂欄 ===== */  .mobile-nav { display: none; }</style></head><body><!-- 首頁入口版面 --><div class="home-entry show" id="homeEntry">  <div class="home-brand">    <div class="hb-logo">↺</div>    <div class="hb-name editable" contenteditable="true" data-edit="homeName">收藏工作站</div>    <div class="hb-sub editable" contenteditable="true" data-edit="homeSub">把收藏變成行動，也看見自己</div>  </div>  <div class="home-cards">    <div class="home-card" onclick="setSpace('collect')">      <span class="hc-go">→</span>      <div class="hc-ico">⚡</div>      <div class="hc-name"><span class="editable" contenteditable="true" data-edit="collectCardName">收藏顯化</span></div>      <div class="hc-desc editable" contenteditable="true" data-edit="collectCardDesc">把收藏拆解成待辦與行動。分類管理、步驟拆解、完成軌跡，讓每一條收藏都不再吃灰。</div>      <div class="hc-stats">        <span class="hc-stat"><b id="homeStatPending">0</b> 待處理</span>        <span class="hc-stat"><b id="homeStatDone">0</b> 已完成</span>      </div>    </div>    <div class="home-card" onclick="setSpace('self')">      <span class="hc-go">→</span>      <div class="hc-ico alt">🌱</div>      <div class="hc-name"><span class="editable" contenteditable="true" data-edit="selfCardName">自我瞭解</span></div>      <div class="hc-desc editable" contenteditable="true" data-edit="selfCardDesc">記錄每一件讓你心動、共鳴或嚮往的事物。慢慢看見自己喜歡什麼、重視什麼。</div>      <div class="hc-stats">        <span class="hc-stat"><b id="homeStatSelf">0</b> 條心動記錄</span>      </div>    </div>    <div class="home-card" onclick="setSpace('place')">      <span class="hc-go">→</span>      <div class="hc-ico alt">📍</div>      <div class="hc-name"><span class="editable" contenteditable="true" data-edit="placeCardName">地點標記</span></div>      <div class="hc-desc editable" contenteditable="true" data-edit="placeCardDesc">把想去的地方收進來：位置、照片、想吃想玩想打卡的重點，去過沒去一目瞭然。</div>      <div class="hc-stats">        <span class="hc-stat"><b id="homeStatWant">0</b> 想去</span>        <span class="hc-stat"><b id="homeStatVisited">0</b> 已打卡</span>      </div>    </div>  </div>  <div class="home-foot">✨ 點擊卡片進入 · 右下角 🎨 為每個空間獨立配色</div></div>​<div class="app" id="appView" style="display:none">  <!-- 窄屏頂欄（側欄隱藏時用於空間切換） -->  <div class="mobile-nav">    <span class="mn-item" data-space="home" onclick="setSpace('home')">⌂ 首頁</span>    <span class="mn-item" data-space="collect" onclick="setSpace('collect')">⚡ 收藏顯化</span>    <span class="mn-item" data-space="self" onclick="setSpace('self')">🌱 自我瞭解</span>    <span class="mn-item" data-space="place" onclick="setSpace('place')">📍 地點</span>  </div>  <!-- 側邊欄 -->  <aside class="sidebar">    <div class="brand" onclick="setSpace('home')" style="cursor:pointer" title="返回首頁">      <div class="logo">↺</div>      <div>        <div class="name editable" contenteditable="true" data-edit="brand" title="點擊可編輯站點名"></div>        <div class="sub editable" contenteditable="true" data-edit="brandSub" title="點擊可編輯副標題"></div>      </div>    </div>​    <nav class="top-nav">      <div class="top-nav-item" data-space="home" onclick="setSpace('home')"><span class="tn-ico">⌂</span>首頁</div>      <div class="top-nav-item" data-space="collect" onclick="setSpace('collect')"><span class="tn-ico">⚡</span>收藏顯化<span class="tn-badge" id="navCollectBadge"></span></div>      <div class="top-nav-item" data-space="self" onclick="setSpace('self')"><span class="tn-ico">🌱</span>自我瞭解<span class="tn-badge" id="navSelfBadge"></span></div>      <div class="top-nav-item" data-space="place" onclick="setSpace('place')"><span class="tn-ico">📍</span>地點標記<span class="tn-badge" id="navPlaceBadge"></span></div>    </nav>​    <div>      <div class="side-title"><span class="editable" contenteditable="true" data-edit="sideCatsTitle" title="點擊可編輯">分類 · 標籤</span><span class="mini" id="catTotal"></span></div>      <div class="cat-list" id="catList"></div>      <div class="cat-add" onclick="openCatModal()">＋ 新增分類</div>    </div>​    <div>      <div class="side-title"><span class="editable" contenteditable="true" data-edit="sideTrashTitle" title="點擊可編輯">垃圾桶</span></div>      <div class="trash-entry" onclick="openTrash()" title="查看已刪除內容">        <span class="t-ico">🗑</span>        <span class="editable" contenteditable="true" data-edit="trashEntryLabel" title="點擊可編輯" onclick="event.stopPropagation()">已刪除內容</span>        <span class="t-cnt" id="trashCnt">0</span>      </div>    </div>​    <div>      <div class="side-title"><span class="editable" contenteditable="true" data-edit="sideRecentTitle" title="點擊可編輯">最近完成</span></div>      <div class="recent-box">        <div class="recent-head">          <div class="recent-badge" id="weekNum">0</div>          <div class="recent-label"><span class="editable" contenteditable="true" data-edit="recentHeadLabel" title="點擊可編輯">本週期已完成</span><br><span id="recentLabelSub" title="點擊可編輯，{n} 代表數量" class="editable" contenteditable="true" data-edit="recentLabelSubTpl"></span></div>        </div>        <div class="progress-track"><div class="progress-fill" id="weekBar" style="width:0%"></div></div>        <div class="progress-note" id="weekNote">繼續向前走 · 保持行動</div>        <div class="recent-list only-collect" id="recentList"></div>        <div class="recent-divider" id="todayDivider">今日待辦</div>        <div class="todo-mini" id="todoMini"></div>        <!-- 自我瞭解：今日待辦輸入替換為「此刻想法」記錄提示 -->        <div class="recent-divider only-self" id="selfRecentDivider" style="display:none">最近記錄</div>        <div class="recent-list only-self" id="selfRecentList" style="display:none"></div>        <!-- 地點標記：最近標記的地點 -->        <div class="recent-divider only-place" id="placeRecentDivider" style="display:none">最近標記</div>        <div class="recent-list only-place" id="placeRecentList" style="display:none"></div>      </div>    </div>​    <div class="only-collect">      <div class="side-title"><span class="editable" contenteditable="true" data-edit="sideCalTitle" title="點擊可編輯">完成軌跡</span></div>      <div class="cal-head">        <span class="nav" id="calPrev">‹</span>        <span class="m" id="calMonth"></span>        <span class="nav" id="calNext">›</span>      </div>      <div class="cal-grid" id="calGrid"></div>    </div>​    <!-- 數據備份（導出 / 導入） -->    <div class="side-backup">      <div class="side-title">數據備份</div>      <div class="backup-row">        <button class="backup-btn" onclick="exportData()" title="把全部數據下載為 JSON 備份文件">⬇ 導出備份</button>        <button class="backup-btn" onclick="document.getElementById('importFile').click()" title="從備份文件恢復數據">⬆ 導入備份</button>      </div>      <input type="file" id="importFile" accept=".json,application/json" hidden onchange="importData(this)">      <div class="backup-note">數據僅保存在本機瀏覽器，換設備 / 清緩存前請先導出。</div>    </div>  </aside>​  <!-- 主區 -->  <main class="main">    <div class="main-inner">      <div class="banner">        <span class="spark">✨</span>        <span class="editable" contenteditable="true" data-edit="banner" title="點擊可編輯標語"></span>        <span class="quote editable" contenteditable="true" data-edit="bannerQuote" title="點擊可編輯小字"></span>      </div>​      <div class="page-title editable" contenteditable="true" data-edit="pageTitle" title="點擊可編輯標題"></div>      <div class="page-desc editable" contenteditable="true" data-edit="pageDesc" title="點擊可編輯描述"></div>​      <div class="stats" id="mainStats">        <div class="stat c1"><div class="num" id="stPending">0</div><div class="label editable" contenteditable="true" data-edit="statPendingLabel" title="點擊可編輯">待處理 · 等待被拆解</div></div>        <div class="stat c2"><div class="num" id="stDone">0</div><div class="label editable" contenteditable="true" data-edit="statDoneLabel" title="點擊可編輯">已完成小事</div></div>        <div class="stat c3 only-collect"><div class="num" id="stThink">0</div><div class="label editable" contenteditable="true" data-edit="statThinkLabel" title="點擊可編輯">待思考 · 稍後再説</div></div>      </div>​      <!-- 地點標記：三張地區統計卡（可點擊篩選） -->      <div class="stats-region only-place" id="placeStats" style="display:none">        <div class="stat region-card rc-foreign" id="rcForeign" onclick="setRegion('foreign')" title="只看外地地點">          <div class="num" id="stForeign">0</div><div class="rl">Foreign</div><div class="rh">外地</div>        </div>        <div class="stat region-card rc-mainland" id="rcMainland" onclick="setRegion('mainland')" title="只看內地地點">          <div class="num" id="stMainland">0</div><div class="rl">Mainland</div><div class="rh">內地</div>        </div>        <div class="stat region-card rc-local" id="rcLocal" onclick="setRegion('local')" title="只看本地地點">          <div class="num" id="stLocal">0</div><div class="rl">Local</div><div class="rh">本地</div>        </div>      </div>​      <div class="today only-collect">        <div class="t-icon">✎</div>        <div>          <div class="t-title editable" contenteditable="true" data-edit="todayTitle" title="點擊可編輯">今日待辦</div>          <div class="t-sub" id="todaySub">今天可以嘗試做哪些小待辦</div>        </div>        <input class="t-input" id="todayInput" placeholder="+ 添加一條今日小待辦，回車即存">        <button class="t-add" id="todayAdd">+ 添加</button>      </div>​      <div class="searchbar">        <input id="searchInput" placeholder="🔍 搜索標題 / 想法 / 觸動點 / 標籤">        <div class="filter" id="filterChips">          <span class="chip active" data-f="all" onclick="setFilter('all')">全部</span>          <span class="chip" data-f="todo" onclick="setFilter('todo')">待辦</span>          <span class="chip" data-f="done" onclick="setFilter('done')">已完成</span>        </div>      </div>​      <div class="cats-tabs" id="tabs"></div>​      <div id="boardArea">        <div class="board-title">          <span class="editable" contenteditable="true" data-edit="boardPending" title="點擊可編輯">待處理</span>          <span class="n" id="pendingN">0</span>          <span class="n" id="pendingFlagBadge" style="display:none;background:#fbeeec;color:var(--danger)">🚩 置頂</span>          <span class="spacer"></span>          <span class="icon-btn" onclick="sortByTime()" title="按時間排序">⤓</span>        </div>        <div class="cards" id="pendingCards"></div>        <div class="section" id="doneSection" style="display:none">          <div class="board-title">            <span class="editable" contenteditable="true" data-edit="boardDone" title="點擊可編輯">已完成</span>            <span class="n" id="doneN">0</span>          </div>          <div class="cards" id="doneCards"></div>        </div>      </div>​      <div class="section only-collect" id="trackSection">        <div class="board-title">          <span class="editable" contenteditable="true" data-edit="boardTrack" title="點擊可編輯">完成軌跡</span> <span class="n" id="trackN">0</span>          <span class="spacer"></span>          <span class="icon-btn" title="完成軌跡">⤢</span>        </div>        <div class="track" id="track"></div>      </div>    </div>  </main></div>​<button class="theme-fab" onclick="openTheme()" title="主題色設置">🎨<span class="dot-preview"></span></button><button class="add-fab" data-space="collect" onclick="openModal()">＋ 添加收藏</button><button class="add-fab" data-space="self" onclick="openModal()" style="display:none">＋ 記錄觸動</button><button class="add-fab" data-space="place" onclick="openModal()" style="display:none">＋ 標記地點</button>​<!-- 主題色設置彈窗（Google 風格） --><div class="overlay" id="themeOverlay">  <div class="modal sm">    <div class="modal-head"><h2>🎨 顏色和主題</h2><span class="close" onclick="closeTheme()">✕</span></div>    <div class="modal-body">      <div id="themeSpaceLabel" style="font-size:12px;color:var(--ink-soft);background:var(--brand-soft);padding:6px 10px;border-radius:6px;margin-bottom:10px;border:1px solid var(--brand-semi)"></div>      <div class="field">        <label>點選任一顏色，立即生效</label>        <div class="g-grid" id="themeGrid"></div>      </div>      <div class="field">        <label>自定義顏色 · 輸入 Hex</label>        <div class="hex-row">          <input id="themeHex" placeholder="#12a150" maxlength="7" spellcheck="false">          <div class="hex-preview" id="themeHexPreview" title="當前選中"></div>        </div>        <div class="hint">支持 6 位（如 #0984e3）或 3 位（如 #e43）色值，輸入合法即實時預覽。</div>      </div>    </div>    <div class="modal-foot" style="justify-content: space-between;">      <button class="btn ghost" onclick="resetTheme()">恢復默認</button>      <div style="display:flex;gap:10px;">        <button class="btn ghost" onclick="closeTheme(true)">取消</button>        <button class="btn primary" onclick="saveTheme()">應用</button>      </div>    </div>  </div></div>​<!-- 添加收藏 / 觸動記錄彈窗 --><div class="overlay" id="overlay">  <div class="modal">    <div class="modal-head"><h2 id="modalTitle">添加收藏</h2><span class="close" onclick="closeModal()">✕</span></div>    <div class="modal-body">      <div class="field">        <label id="fTitleLabel">標題（如無鏈接則自動生成，可修改）</label>        <input id="fTitle" placeholder="這條收藏講的是什麼">      </div>      <div class="field">        <div class="row2">          <div>            <label>鏈接</label>            <input id="fLink" placeholder="粘貼鏈接 url">          </div>          <div>            <label id="fPlatformLabel">來源平台</label>            <select id="fPlatform">              <option>小紅書</option><option>抖音</option><option>B站</option>              <option>播客</option><option>公眾號</option><option>網頁</option>            </select>          </div>        </div>        <div class="hint" id="fLinkHint" style="display:none">可粘貼地圖分享鏈接（如高德 / Google Maps），方便到時候導航。</div>      </div>      <div class="field" id="fRegionField" style="display:none">        <label>地區（它在外地、內地還是本地？）</label>        <div class="region-pick">          <button type="button" class="rg" data-rg="foreign" onclick="pickRegion('foreign')">Foreign<span class="rg-sub">外地</span></button>          <button type="button" class="rg" data-rg="mainland" onclick="pickRegion('mainland')">Mainland<span class="rg-sub">內地</span></button>          <button type="button" class="rg" data-rg="local" onclick="pickRegion('local')">Local<span class="rg-sub">本地</span></button>        </div>      </div>      <div class="field" id="fImgField" style="display:none">        <label>地點照片（可選，自動壓縮存儲）</label>        <div class="img-pick" id="imgPick" onclick="document.getElementById('fImgFile').click()">📷 點擊選擇照片</div>        <input type="file" id="fImgFile" accept="image/*" hidden>        <div class="img-preview-row" id="imgPreviewRow" style="display:none">          <img id="imgPreview" alt="預覽">          <button class="btn tiny ghost" type="button" onclick="clearPickedImg()">✕ 移除</button>        </div>      </div>      <div class="field">        <label id="fIdeaLabel">想法</label>        <textarea id="fIdea" placeholder="一句話：當初為什麼收藏它？打算拿它做什麼？"></textarea>        <div class="hint" id="fIdeaHint">寫清楚動機，AI 才能幫你更好地拆解成行動。</div>      </div>      <div class="field" id="fStepsField">        <label>待辦步驟（每步單獨編輯/刪除，可不填）</label>        <div class="steps-editor" id="stepsEditor"></div>        <button class="add-step" onclick="addStep()">＋ 添加一步</button>        <div class="hint">可逐條勾選。可切換不同視角，可設「立即做」「稍後做」「我做到了」。完成