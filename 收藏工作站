aceSiteDefaults() {  if (activeSpace === 'self') return defaultSelfSpace().site;  if (activeSpace === 'place') return defaultPlaceSpace().site;  return DEFAULT_SITE;}function load() {  try {    let raw = localStorage.getItem(STORAGE_KEY) || localStorage.getItem(LEGACY_KEY);    if (raw) {      const d = JSON.parse(raw);      if (d && Array.isArray(d.collections)) {        state.collections = d.collections;        if (Array.isArray(d.today)) state.today = d.today;        if (Array.isArray(d.cats) && d.cats.length) state.cats = d.cats;        if (Array.isArray(d.trash)) state.trash = d.trash;        if (d.site) state.site = Object.assign({}, DEFAULT_SITE, d.site);        if (typeof d.theme === 'string' && normHex(d.theme)) state.theme = normHex(d.theme);      }    }  } catch (e) {}  // 自我瞭解空間  try {    const s2 = localStorage.getItem('anti-self-v1');    state2 = s2 ? JSON.parse(s2) : defaultSelfSpace();    if (!state2 || !Array.isArray(state2.collections) || !Array.isArray(state2.cats)) state2 = defaultSelfSpace();    if (!Array.isArray(state2.trash)) state2.trash = [];    state2.site = Object.assign({}, defaultSelfSpace().site, state2.site || {});  } catch (e) { state2 = defaultSelfSpace(); }  // 地點標記空間  try {    const s3 = localStorage.getItem('anti-place-v1');    state3 = s3 ? JSON.parse(s3) : defaultPlaceSpace();    if (!state3 || !Array.isArray(state3.collections) || !Array.isArray(state3.cats)) state3 = defaultPlaceSpace();    if (!Array.isArray(state3.trash)) state3.trash = [];    state3.site = Object.assign({}, defaultPlaceSpace().site, state3.site || {});    // 舊數據補地區默認值（本地）    const RG = new Set(['foreign', 'mainland', 'local']);    state3.collections.forEach(c => { if (!RG.has(c.region)) c.region = 'local'; });    (state3.trash || []).forEach(t => { if (t.data && !RG.has(t.data.region)) t.data.region = 'local'; });  } catch (e) { state3 = defaultPlaceSpace(); }  // 清理孤兒標籤（各空間各自清理）  [state, state2, state3].forEach(s => {    if (!s || !Array.isArray(s.collecti